<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.econest.view.AgentPanel">
  <grid id="bd125" binding="rootPanel" layout-manager="BorderLayout" hgap="0" vgap="0">

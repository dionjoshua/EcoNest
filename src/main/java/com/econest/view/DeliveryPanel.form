              <grid id="95b8c" layout-manager="BorderLayout" hgap="0" vgap="0">
                <constraints>
                  <grid row="12" column="0" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="8" fill="3" indent="0" use-parent-layout="false"/>

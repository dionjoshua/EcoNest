                <properties/>
              </component>
              <component id="1a219" class="javax.swing.JButton" binding="btnAssign">
                <constraints>
                  <grid row="7" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag top="14" left="0" bottom="0" right="0" weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <text value="Assign agent"/>
                  <background color="-12451305"/>
                  <foreground color="-1"/>

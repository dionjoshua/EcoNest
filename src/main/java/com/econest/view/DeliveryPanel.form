              </component>
              <component id="9bda7" class="javax.swing.JTextField" binding="txtDeliveryDate">
                <constraints>
                  <grid row="6" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="1.0" weighty="0.0"/>

              <component id="d8e81" class="javax.swing.JLabel">
                <constraints>
                  <grid row="8" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag top="24" left="0" bottom="6" right="0" weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>

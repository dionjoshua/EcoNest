<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.econest.view.DeliveryPanel">
  <grid id="3d1c7" binding="rootPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="980" height="660"/>
    </constraints>
    <properties>
      <background color="-527378"/>
    </properties>
    <border type="empty">
      <size top="20" left="22" bottom="20" right="22"/>
    </border>
    <children>
      <grid id="d4d6c" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="North"/>
        <properties>
          <opaque value="false"/>
        </properties>
        <border type="empty">
          <size top="0" left="0" bottom="16" right="0"/>
        </border>
        <children>
          <grid id="516e4" layout-manager="GridBagLayout">
            <constraints border-constraint="West"/>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="e7505" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <text value="Deliveries"/>
                  <foreground color="-14018019"/>
                  <font size="22" style="1"/>
                </properties>
              </component>
              <component id="a0618" class="javax.swing.JLabel">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag top="2" left="0" bottom="0" right="0" weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <text value="Assign agents, schedule and track each order"/>
                  <foreground color="-7570572"/>
                  <font size="12"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="d34d3" layout-manager="FlowLayout" hgap="8" vgap="6" flow-align="2">
            <constraints border-constraint="East"/>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="47fc0" class="javax.swing.JCheckBox" binding="chkActiveOnly">
                <constraints/>
                <properties>
                  <text value="Hide delivered and cancelled"/>
                  <selected value="true"/>
                  <opaque value="false"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
      <grid id="265d2" layout-manager="BorderLayout" hgap="16" vgap="0">
        <constraints border-constraint="Center"/>
        <properties>
          <opaque value="false"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="3d582" binding="cardTable" custom-create="true" layout-manager="BorderLayout" hgap="0" vgap="12">
            <constraints border-constraint="Center"/>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="empty">
              <size top="12" left="12" bottom="12" right="12"/>
            </border>
            <children>
              <scrollpane id="dacc0">
                <constraints border-constraint="Center"/>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="4e786" class="javax.swing.JTable" binding="tblDeliveries">
                    <constraints/>
                    <properties/>
                  </component>
                </children>
              </scrollpane>
              <grid id="4683f" layout-manager="BorderLayout" hgap="0" vgap="6">
                <constraints border-constraint="South"/>
                <properties>
                  <opaque value="false"/>
                </properties>
                <border type="none"/>
                <children>
                  <component id="df065" class="javax.swing.JLabel">
                    <constraints border-constraint="North"/>
                    <properties>
                      <text value="Email notifications sent"/>
                      <foreground color="-14018019"/>
                      <font size="13" style="1"/>
                    </properties>
                  </component>
                  <scrollpane id="2151f">
                    <constraints border-constraint="Center"/>
                    <properties>
                      <preferredSize width="-1" height="150"/>
                    </properties>
                    <border type="none"/>
                    <children>
                      <component id="2ab08" class="javax.swing.JTable" binding="tblEmailLog">
                        <constraints/>
                        <properties/>
                      </component>
                    </children>
                  </scrollpane>
                </children>
              </grid>
            </children>
          </grid>
          <grid id="c0108" binding="cardForm" custom-create="true" layout-manager="GridBagLayout">
            <constraints border-constraint="East"/>
            <properties>
              <opaque value="false"/>
              <preferredSize width="292" height="-1"/>
            </properties>
            <border type="empty">
              <size top="18" left="18" bottom="18" right="18"/>
            </border>
            <children>
              <component id="9d6ef" class="javax.swing.JLabel" binding="lblOrder">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <text value="Select an order"/>
                  <foreground color="-14018019"/>
                  <font size="15" style="1"/>
                </properties>
              </component>
              <component id="cb220" class="javax.swing.JLabel" binding="lblOrderInfo">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag top="3" left="0" bottom="14" right="0" weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <text value="Click a row in the table"/>
                  <foreground color="-7570572"/>
                  <font size="12"/>
                </properties>
              </component>
              <component id="261dc" class="javax.swing.JLabel">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag top="0" left="0" bottom="4" right="0" weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <text value="Assign delivery"/>
                  <foreground color="-12451305"/>
                  <font size="13" style="1"/>
                </properties>
              </component>
              <component id="e4ba2" class="javax.swing.JLabel">
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag top="10" left="0" bottom="3" right="0" weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <text value="Delivery agent"/>
                  <foreground color="-7570572"/>
                  <font size="12"/>
                </properties>
              </component>
              <component id="ecf4b" class="javax.swing.JComboBox" binding="cmbAgent">

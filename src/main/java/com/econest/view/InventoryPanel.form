                    <border type="none"/>
                    <children>
                      <component id="ee18c" class="javax.swing.JTable" binding="tblHistory">
                        <constraints/>
                        <properties/>
                      </component>
                    </children>
                  </scrollpane>
                </children>
              </grid>
            </children>
          </grid>

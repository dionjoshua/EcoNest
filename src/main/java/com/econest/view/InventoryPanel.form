<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.econest.view.InventoryPanel">
  <grid id="a8fd2" binding="rootPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="980" height="660"/>
    </constraints>
    <properties>
      <background color="-527378"/>
    </properties>
    <border type="empty">
      <size top="20" left="22" bottom="20" right="22"/>
    </border>
    <children>
      <grid id="1ed8c" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="North"/>
        <properties>
          <opaque value="false"/>
        </properties>
        <border type="empty">
          <size top="0" left="0" bottom="16" right="0"/>
        </border>
        <children>
          <grid id="caaa3" layout-manager="GridBagLayout">
            <constraints border-constraint="West"/>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="878ac" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <text value="Stock / Inventory"/>
                  <foreground color="-14018019"/>
                  <font size="22" style="1"/>
                </properties>
              </component>
              <component id="4c7d8" class="javax.swing.JLabel">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag top="2" left="0" bottom="0" right="0" weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <text value="Quantity on hand, reorder levels and supplier deliveries"/>
                  <foreground color="-7570572"/>
                  <font size="12"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="a047f" layout-manager="FlowLayout" hgap="8" vgap="6" flow-align="2">
            <constraints border-constraint="East"/>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="904b3" class="javax.swing.JCheckBox" binding="chkLowOnly">
                <constraints/>
                <properties>
                  <text value="Show low stock only"/>
                  <opaque value="false"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
      <grid id="ecb6e" layout-manager="BorderLayout" hgap="16" vgap="0">
        <constraints border-constraint="Center"/>
        <properties>
          <opaque value="false"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="6169d" binding="cardTable" custom-create="true" layout-manager="BorderLayout" hgap="0" vgap="12">
            <constraints border-constraint="Center"/>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="empty">
              <size top="12" left="12" bottom="12" right="12"/>
            </border>
            <children>
              <scrollpane id="20df0">
                <constraints border-constraint="Center"/>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="9ab06" class="javax.swing.JTable" binding="tblStock">
                    <constraints/>
                    <properties/>
                  </component>
                </children>
              </scrollpane>
              <grid id="19e95" layout-manager="BorderLayout" hgap="0" vgap="6">
                <constraints border-constraint="South"/>
                <properties>
                  <opaque value="false"/>
                </properties>
                <border type="none"/>
                <children>
                  <component id="07c32" class="javax.swing.JLabel">
                    <constraints border-constraint="North"/>
                    <properties>
                      <text value="Recent stock-in"/>
                      <foreground color="-14018019"/>
                      <font size="13" style="1"/>
                    </properties>
                  </component>
                  <scrollpane id="c4db4">
                    <constraints border-constraint="Center"/>
                    <properties>
                      <preferredSize width="-1" height="150"/>

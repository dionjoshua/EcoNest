<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.econest.view.DashboardPanel">
  <grid id="78b91" binding="rootPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="980" height="660"/>
    </constraints>
    <properties>
      <background color="-527378"/>
    </properties>
    <border type="empty">
      <size top="20" left="22" bottom="20" right="22"/>
    </border>
    <children>
      <grid id="cd591" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="North"/>
        <properties>
          <opaque value="false"/>
        </properties>
        <border type="empty">
          <size top="0" left="0" bottom="16" right="0"/>
        </border>
        <children>
          <grid id="1cec1" layout-manager="GridBagLayout">
            <constraints border-constraint="West"/>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="29b7c" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <text value="Dashboard"/>
                  <foreground color="-14018019"/>
                  <font size="22" style="1"/>
                </properties>
              </component>
              <component id="c112c" class="javax.swing.JLabel">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag top="2" left="0" bottom="0" right="0" weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <text value="How the shop is doing right now"/>
                  <foreground color="-7570572"/>
                  <font size="12"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="d0420" layout-manager="FlowLayout" hgap="8" vgap="6" flow-align="2">
            <constraints border-constraint="East"/>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="883b7" class="javax.swing.JButton" binding="btnRefresh">
                <constraints/>
                <properties>
                  <text value="Refresh"/>
                  <background color="-1054753"/>
                  <foreground color="-14018019"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
      <grid id="ba0a3" layout-manager="GridBagLayout">
